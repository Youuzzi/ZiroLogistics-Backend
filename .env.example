# Copy to .env and replace both password placeholders before starting Compose.
# This template is safe to commit; never commit the populated .env file.

WMS_DB_USERNAME=zirologistics_wms
WMS_DB_PASSWORD=replace-with-a-unique-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-unique-local-root-password

# Explicitly applies WMS migrations only to this dedicated Compose database/volume.
WMS_FLYWAY_ENABLED=true

# Secure defaults: all WMS HTTP routes deny access until JWT is configured.
WMS_JWT_ENABLED=false
WMS_SECURITY_HTTP_AUTH_ENDPOINTS_ENABLED=false

# Non-secret identifiers used only while JWT is disabled.
WMS_JWT_ISSUER=https://zirologistics.local
WMS_JWT_SELECTION_AUDIENCE=zirologistics-wms-selection
WMS_JWT_ACCESS_AUDIENCE=zirologistics-wms-access
WMS_JWT_KEY_ID=local-disabled
